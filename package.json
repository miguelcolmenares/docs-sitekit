{
  "name": "docs-sitekit",
  "version": "0.2.2",
  "description": "Design system and scaffold for documentation microsites on GitHub Pages: Astro, Tailwind, shadcn/ui and lucide-react.",
  "author": "Miguel Colmenares <me@miguelcolmenares.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "sitekit": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "template",
    "!template/node_modules",
    "!template/dist",
    "!template/.astro",
    "!template/sitekit.config.json",
    "!template/src/examples",
    "!template/src/presentation/layouts/collections",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "node scripts/verify-package.mjs && playwright test -c e2e/playwright.config.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "husky",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:brands": "node scripts/build-brands.mjs",
    "build:docs": "node scripts/build-docs.mjs && node scripts/build-component-docs.mjs && node scripts/build-recipe-docs.mjs",
    "bootstrap": "npm ci && npm ci --prefix template"
  },
  "keywords": [
    "documentation",
    "docs",
    "github-pages",
    "astro",
    "tailwind",
    "shadcn",
    "design-system",
    "scaffold"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelcolmenares/docs-sitekit.git"
  },
  "bugs": {
    "url": "https://github.com/miguelcolmenares/docs-sitekit/issues"
  },
  "homepage": "https://github.com/miguelcolmenares/docs-sitekit#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "simple-icons": "16.36.0",
    "tsdown": "^0.23.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  }
}
