{
  "site": {
    "name": "sitekit",
    "description": "Design system and scaffold for documentation microsites on GitHub Pages.",
    "url": "https://miguelcolmenares.com",
    "base": "/docs-sitekit/",
    "repository": "https://github.com/miguelcolmenares/docs-sitekit",
    "license": "MIT",
    "installCommand": "npx docs-sitekit init"
  },
  "hero": {
    "badge": "Astro \u00b7 Tailwind \u00b7 shadcn/ui \u00b7 lucide",
    "title": "Documentation sites that look like a product.",
    "lede": "A design system with a light and a dark theme, a content pipeline that reads your repository, and a scaffold that publishes to GitHub Pages. MIT licensed.",
    "primary": {
      "label": "Get started",
      "href": "/docs/getting-started/"
    },
    "secondary": {
      "label": "Browse the components",
      "href": "/docs/components/"
    }
  },
  "stats": [
    { "value": "2", "label": "Themes", "note": "Dark and light, with a switch in the header." },
    { "value": "3", "label": "Phone widths tested", "note": "320, 360 and 390 px, plus desktop." },
    {
      "value": "4",
      "label": "Layers",
      "note": "Domain, application, infrastructure and presentation."
    },
    { "value": "MIT", "label": "License", "note": "Written from scratch." }
  ],
  "features": [
    {
      "icon": "layers",
      "eyebrow": "Design system",
      "title": "Tokens and components you own",
      "text": "Components are copied into your site, shadcn style. Edit them freely. One tokens file drives every color, radius and font."
    },
    {
      "icon": "file-text",
      "eyebrow": "Your repository is the source",
      "title": "Docs from the files you already have",
      "text": "Markdown in docs, examples and the changelog becomes pages. Relative links keep working on GitHub and on the site."
    },
    {
      "icon": "shield-check",
      "eyebrow": "Safe to publish",
      "title": "A closed contract and a publish check",
      "text": "Unknown config keys fail the build. A scan looks for credentials and internal hosts before anything is deployed."
    },
    {
      "icon": "zap",
      "eyebrow": "Fast by default",
      "title": "Static HTML, almost no JavaScript",
      "text": "Every route is a real HTML file with its own title. Only the copy buttons, the mobile menu and search (loaded on demand) ship JavaScript."
    }
  ],
  "sources": {
    "root": "..",
    "changelog": "../CHANGELOG.md"
  },
  "collections": [
    {
      "id": "docs",
      "label": "Docs",
      "dir": "../docs",
      "lede": "Guides and reference for using sitekit.",
      "groups": [
        {
          "name": "Start",
          "tone": "brand",
          "items": ["getting-started", "configuration", "upgrading"]
        },
        {
          "name": "Options by topic",
          "tone": "brand",
          "items": [
            "options",
            "options-identity",
            "options-navigation",
            "options-theme",
            "options-search-llms",
            "options-checks",
            "options-edit-link",
            "options-brand-logos"
          ]
        },
        {
          "name": "Design system",
          "tone": "neutral",
          "items": ["components", "brand-logos", "design-tokens", "detail-page", "performance"]
        },
        {
          "name": "Content",
          "tone": "success",
          "items": [
            "content",
            "callouts",
            "code-blocks",
            "deploying",
            "search",
            "llms",
            "edit-link"
          ]
        }
      ]
    },
    {
      "id": "components",
      "label": "Components",
      "dir": "../docs/components",
      "lede": "Every component of the kit with a live preview, the code that produced it, the command to add it and its props.",
      "groups": [
        {
          "name": "Foundation",
          "tone": "neutral",
          "items": ["button", "tone-badge", "icon"]
        },
        {
          "name": "Layout",
          "tone": "brand",
          "items": ["section-header", "hero", "cta-band", "site-footer"]
        },
        {
          "name": "Content",
          "tone": "success",
          "items": ["item-card", "feature-grid", "stat-row", "flow-diagram", "callout", "side-card"]
        },
        {
          "name": "Reference and commands",
          "tone": "warn",
          "items": ["reference-table", "command-table", "command-box"]
        },
        {
          "name": "Navigation and page",
          "tone": "neutral",
          "items": ["breadcrumbs", "catalog-filter", "page-info"]
        }
      ]
    },
    {
      "id": "examples",
      "label": "Examples",
      "dir": "../examples",
      "lede": "Working examples you can copy and adapt."
    }
  ],
  "search": {
    "enabled": true
  },
  "deploy": {
    "target": "github-pages",
    "acknowledgePublicPages": false,
    "repositoryVisibility": "public"
  },
  "anonymize": {
    "allow": ["builder.internal", "support@acme.example"]
  },
  "check": {
    "callouts": "off"
  },
  "editLink": {
    "enabled": true,
    "branch": "main"
  },
  "lastUpdated": {
    "enabled": true
  },
  "llms": {
    "enabled": true,
    "optional": ["examples"],
    "markdownPages": true
  }
}
